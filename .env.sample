# Web
FASTFUNNEL_HOST=127.0.0.1
FASTFUNNEL_PORT=5005
FASTFUNNEL_BASE_URL=http://127.0.0.1:5005
FASTFUNNEL_DEV_AUTH_BYPASS=1
FASTFUNNEL_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://funnel.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# Initial dogfood workspace
FASTFUNNEL_ADMIN_EMAIL=admin@fastfunnel.app
FASTFUNNEL_SEED_COMPANY=Predictive Labs
FASTFUNNEL_SEED_DOMAIN=predictivelabs.ai

# Team invitations (optional until provided)
POSTMARK_SERVER_TOKEN=

# Model providers (future live agent execution)
XAI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Delegated integration providers
COMPOSIO_API_KEY=
COMPOSIO_API_BASE=https://backend.composio.dev/api/v3
ARCADE_API_KEY=
ARCADE_API_BASE=https://api.arcade.dev/v1

# CRM and lifecycle reporting
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
BREVO_API_KEY=
BREVO_ACCOUNT_ID=

# Google Analytics and Sheets (short-lived access tokens should be supplied
# through the deployment secret manager, never committed)
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_ACCESS_TOKEN=
GOOGLE_SHEETS_ACCESS_TOKEN=

# Direct advertising APIs
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://funnel.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Workspace API tokens are created and revoked in the authenticated Settings UI.
